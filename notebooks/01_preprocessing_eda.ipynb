import sys
sys.path.append('..') # Allow notebook to look into the src/ folder
import pandas as pd
from src.pipeline import compute_proxy_labels, clean_tender_text

# Load raw dataset (e.g., Ireland data)
df = pd.read_json("../data/ireland_contracts_raw.json") 

# Clean text fields
df['cleaned_description'] = df['description'].apply(clean_tender_text)

# Generate multi-label array targets
df = compute_proxy_labels(df)

# Export the baseline data so other team members can build models from it
df.to_csv("../data/contracts_clean.csv", index=False)
print("Data fully preprocessed, labeled, and saved for the team!")
